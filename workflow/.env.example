# Copy to .env and fill in.

# --- LLM (script generation) ---
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# TRACEVIDS_MODEL=gpt-4o-mini

# Or OpenRouter
# OPENROUTER_API_KEY=sk-or-...
# TRACEVIDS_MODEL=openai/gpt-4o-mini

# --- TTS narration (same OpenAI-compatible key) ---
# Primary: OpenAI Audio Speech API
# TRACEVIDS_TTS_MODEL=tts-1
# TRACEVIDS_TTS_VOICE=nova
# Fallback on macOS without key: system `say`
# TRACEVIDS_SAY_VOICE=Tingting
